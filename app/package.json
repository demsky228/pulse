{
  "name": "pulse-optimizer",
  "productName": "PULSE",
  "version": "1.4.0",
  "description": "PULSE — оптимизатор ПК для игр",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pulse.optimizer",
    "productName": "PULSE",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "PULSE.exe",
      "requestExecutionLevel": "admin"
    }
  }
}